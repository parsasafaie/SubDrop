{
  "manifest_version": 2,
  "name": "SubDrop",
  "version": "0.4",
  "description": "Overlay subtitle files on any video, and copy a page's captions to translate with AI.",

  "browser_specific_settings": {
    "gecko": {
      "id": "persian-sub-proto@example.local",
      "strict_min_version": "115.0"
    }
  },

  "permissions": ["<all_urls>", "tabs", "storage", "clipboardRead"],


  "background": {
    "scripts": ["parser.js", "background.js"],
    "persistent": false
  },

  "browser_action": {
    "default_title": "SubDrop (Alt+Shift+P)",
    "default_popup": "popup.html"
  },

  "commands": {
    "_execute_browser_action": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Open the SubDrop popup"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["parser.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": false
    }
  ]
}
